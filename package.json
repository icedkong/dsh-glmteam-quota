{
  "name": "dsh-glmteam-quota",
  "version": "0.1.0",
  "description": "GLM Quota+ — quota and usage dashboard for DeepSeek Harness: multi-provider balances and subscription quotas (DeepSeek, GLM / Z.AI including GLM Team Plan, MiniMax, OpenCode, Codex) plus OpenAI organization spend. Focused fork of DSH Quota+.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/icedkong/dsh-glmteam-quota.git" },
  "homepage": "https://github.com/icedkong/dsh-glmteam-quota#readme",
  "bugs": { "url": "https://github.com/icedkong/dsh-glmteam-quota/issues" },
  "type": "module",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "quota", "usage", "openai", "deepseek", "glm", "zai", "bigmodel", "team-plan", "minimax", "opencode"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": ["index.js", "client.js", "src", "company-rules.json", "cordis.patch.yml", "locale", "icon.png", "README.md", "README.zh.md", "CHANGELOG.md", "SECURITY.md", "docs", "LICENSES", "LICENSE"],
  "scripts": {"test": "node --test", "test:company-coverage": "node --test test/company-catalog-coverage.test.js", "sync:company-rules": "node scripts/sync-company-rules.js", "check:company-rules": "node scripts/sync-company-rules.js --check", "sync:company-brand-marks": "node scripts/sync-company-brand-marks.js", "check:company-brand-marks": "node scripts/sync-company-brand-marks.js --check", "check": "node scripts/check-syntax.js && node scripts/sync-company-rules.js --check && node scripts/sync-company-brand-marks.js --check"},
  "engines": {"dsh": ">=0.2.2-rc.1 <0.2.3-0"},
  "publishConfig": {"access": "public"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale", "configForms"]
    }
  }
}
